# Normalize line endings: LF in the repo, native on checkout
* text=auto

# Source files — always LF
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.tex text eol=lf

# Windows scripts — CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Unix scripts — LF
*.sh text eol=lf
Makefile text eol=lf

# Binary assets — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.db binary
*.woff binary
*.woff2 binary
