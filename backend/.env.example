# ── EcoMind AI — example environment file ──────────────────
# Copy to .env and adjust. Defaults work for local development.
# NEVER commit your real .env (it is gitignored).

# FastAPI server
ECOMIND_PORT=8000

# Auth — MUST be changed before any real deployment
ECOMIND_SECRET_KEY=change-me-to-a-long-random-string

# JWT
ECOMIND_ACCESS_TOKEN_EXPIRE_MINUTES=1440
